{
  "name": "acp-chat-bridge",
  "displayName": "ACP Chat Bridge",
  "description": "Native ACP integration test",
  "version": "0.1.7",
  "publisher": "a3st",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./main.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "tsc --noEmit && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "acp-chat-bridge.chat",
        "name": "acp-agent",
        "fullName": "ACP",
        "description": "ACP integration test",
        "isSticky": true,
        "commands": [
          {
            "name": "connections",
            "description": "connections"
          },
          {
            "name": "new",
            "description": "new"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "acp-chat-bridge",
        "displayName": "ACP Chat Bridge",
        "managementCommand": "acp.manageConnections"
      }
    ],
    "commands": [
      {
        "command": "acp.openChat",
        "title": "acp.openChat"
      },
      {
        "command": "acp.manageConnections",
        "title": "acp.manageConnections"
      },
      {
        "command": "acp.addConnection",
        "title": "acp.addConnection"
      },
      {
        "command": "acp.removeConnection",
        "title": "acp.removeConnection"
      }
    ],
    "languageModelTools": [
      {
        "name": "acp_chat_bridge_delegate",
        "displayName": "ACP: Workspace Task",
        "userDescription": "Run a workspace task with an ACP agent, including file changes and agent tools.",
        "modelDescription": "Delegate a complete workspace task to a configured ACP agent. The agent performs its own file edits and tools and returns the final response. Use only for a user-requested ACP task.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "acpTask",
        "icon": "$(tools)",
        "when": "isWorkspaceTrusted",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "description": "The configured ACP connection ID."
            },
            "prompt": {
              "type": "string",
              "description": "The workspace task and conversation context for the ACP agent."
            }
          },
          "required": [
            "connectionId",
            "prompt"
          ],
          "additionalProperties": false
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "acp.openChat",
          "when": "view == workbench.panel.chat.view.copilot",
          "group": "navigation@5"
        }
      ]
    }
  }
}
