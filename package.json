{
  "name": "acp-chat-bridge",
  "displayName": "ACP Chat Bridge",
  "description": "%extension.description%",
  "version": "0.1.16",
  "publisher": "a3st",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onChatParticipant:acp-chat-bridge.chat",
    "onLanguageModelChatProvider:acp-chat-bridge",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%workspaceTrust.description%"
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "compile": "tsc --noEmit && node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "contributes": {
    "chatParticipants": [
      {
        "id": "acp-chat-bridge.chat",
        "name": "acp-agent",
        "fullName": "ACP",
        "description": "%participant.description%",
        "isSticky": true,
        "commands": [
          {
            "name": "mode",
            "description": "%participant.mode.description%"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "acp-chat-bridge",
        "displayName": "ACP",
        "managementCommand": "acp.addConnection"
      }
    ],
    "commands": [
      {
        "command": "acp.openChat",
        "title": "%acp.openChat.title%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "acp.manageConnections",
        "title": "%acp.manageConnections.title%"
      },
      {
        "command": "acp.addConnection",
        "title": "%acp.addConnection.title%"
      },
      {
        "command": "acp.removeConnection",
        "title": "%acp.removeConnection.title%"
      },
      {
        "command": "acp.diagnostics",
        "title": "%acp.diagnostics.title%"
      },
      {
        "command": "acp.selectMode",
        "title": "%acp.selectMode.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "acp.openChat",
          "when": "view == workbench.panel.chat.view.copilot",
          "group": "navigation@5"
        },
        {
          "command": "acp.openChat",
          "when": "view == workbench.panel.chat.view.copilot",
          "group": "1_acp@1"
        }
      ],
      "commandPalette": [
        {
          "command": "acp.addConnection",
          "when": "false"
        },
        {
          "command": "acp.removeConnection",
          "when": "false"
        },
        {
          "command": "acp.selectMode",
          "when": "false"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "acp_chat_bridge_delegate",
        "displayName": "%tool.delegate.title%",
        "userDescription": "%tool.delegate.description%",
        "modelDescription": "Delegate a complete workspace task to a configured ACP agent. The agent performs its own file edits and tools and returns the final response. Use only for a user-requested ACP task.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "acpTask",
        "icon": "$(tools)",
        "when": "isWorkspaceTrusted",
        "inputSchema": {
          "type": "object",
          "properties": {
            "connectionId": {
              "type": "string",
              "description": "The configured ACP connection ID."
            },
            "prompt": {
              "type": "string",
              "description": "The workspace task and conversation context for the ACP agent."
            },
            "modelId": {
              "type": "string",
              "description": "Optional model ID advertised by the ACP agent. Selects the model before running the task."
            },
            "modeId": {
              "type": "string",
              "description": "Optional ACP mode ID, for example build or plan. If omitted, uses the mode selected in Manage Connections."
            }
          },
          "required": [
            "connectionId",
            "prompt"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  "l10n": "./l10n",
  "icon": "assets/icon.png"
}
